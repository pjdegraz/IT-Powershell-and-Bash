              "type": "Extension/HubsExtension/PartType/MarkdownPart",
              "settings": {
                "content": {
                  "settings": {
                    "content": "## Batch operations — quick overview\nBatch and DMF signals are collected in **Application Insights** and stored in the connected **Log Analytics workspace**. These panels are **telemetry observations**, not authoritative F&O job statuses.\n\n**For a custom incident window and the expandable JOB → TASK → RUN tree**, open the detailed Azure Monitor Workbook in the same workspace. **An end event does not necessarily mean success.** Missing events do not prove a job is running.",
                    "title": "D365 F&O — Batch & DMF Operations (UAT)",
                    "subtitle": "Azure Portal monitoring overview",
                    "markdownUri": null
                  }
                }
              }
            }
          },
          {
            "position": {
              "x": 0,
              "y": 3,
              "colSpan": 6,
              "rowSpan": 5
            },
            "metadata": {
              "inputs": [
                {
                  "name": "resourceTypeMode",
                  "isOptional": true
                },
                {
                  "name": "ComponentId",
                  "isOptional": true
                },
                {
                  "name": "Scope",
                  "value": {
                    "resourceIds": [
                      "__REPLACE_WITH_LOG_ANALYTICS_WORKSPACE_RESOURCE_ID__"
                    ]
                  },
                  "isOptional": true
                },
                {
                  "name": "PartId",
                  "value": "7b64d124-65d6-42b7-a9b2-9342c07cc001",
                  "isOptional": true
                },
                {
                  "name": "Version",
                  "value": "2.0",
                  "isOptional": true
                },
                {
                  "name": "TimeRange",
                  "value": "P2D",
                  "isOptional": true
                },
                {
                  "name": "DashboardId",
                  "isOptional": true
                },
                {
                  "name": "DraftRequestParameters",
                  "isOptional": true
                },
                {
                  "name": "Query",
                  "value": "AppEvents\n| where TimeGenerated > ago(48h)\n| where Name in ('BatchTaskStart','BatchTaskFinished','BatchTaskFailure')\n| summarize Starts=countif(Name=='BatchTaskStart'), Finishes=countif(Name=='BatchTaskFinished'), Failures=countif(Name=='BatchTaskFailure') by TimeGenerated=bin(TimeGenerated,15m)\n| order by TimeGenerated asc\n| render timechart",
                  "isOptional": true
                },
                {
                  "name": "ControlType",
                  "value": "FrameControlChart",
                  "isOptional": true
                },
                {
                  "name": "PartTitle",
                  "value": "Batch task activity",
                  "isOptional": true
                },
                {
                  "name": "PartSubTitle",
                  "value": "Starts, finishes, failures — last 48h",
                  "isOptional": true
                },
                {
                  "name": "IsQueryContainTimeRange",
                  "value": true,
                  "isOptional": true
                },
                {
                  "name": "SpecificChart",
                  "value": "Line",
                  "isOptional": true
                },
                {
                  "name": "Dimensions",
                  "value": {
                    "xAxis": {
                      "name": "TimeGenerated",
                      "type": "datetime"
                    },
                    "yAxis": [
                      {
                        "name": "Starts",
                        "type": "long"
                      },
                      {
                        "name": "Finishes",
                        "type": "long"
                      },
                      {
                        "name": "Failures",
                        "type": "long"
                      }
                    ],
                    "aggregation": "Sum"
                  },
                  "isOptional": true
                },
                {
                  "name": "LegendOptions",
                  "value": {
                    "isEnabled": true,
                    "position": "Bottom"
                  },
                  "isOptional": true
                }
              ],
              "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
              "settings": {}
            }
          },
